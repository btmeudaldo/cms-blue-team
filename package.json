{
  "name": "cms-blue-team",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test e2e/0 --project=chromium",
    "test:e2e:all": "playwright test e2e/0",
    "test:e2e:smoke": "playwright test e2e/01-smoke-and-public.spec.ts --project=chromium",
    "test:e2e:auth": "playwright test e2e/02-auth-security.spec.ts --project=chromium",
    "test:e2e:student": "playwright test e2e/03-student-learning.spec.ts --project=chromium",
    "test:e2e:admin": "playwright test e2e/04-admin-operations.spec.ts --project=chromium",
    "test:e2e:mobile": "playwright test e2e/05-responsive-a11y.spec.ts --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:launch": "playwright test e2e/launch-real.spec.ts --project=chromium",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier --check .",
    "test:db": "supabase test db --local supabase/tests",
    "clean:vercel": "node scripts/clean-vercel-deployments.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.57.4",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "basic-ftp": "^6.2.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "pg": "^8.23.0",
    "prettier": "^3.6.0",
    "supabase": "^2.111.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
